<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B111C"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEPTH EFFECT"
            android:textColor="#92B9E5"
            android:textSize="10sp"
            android:letterSpacing="0.16"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/mask_editor_title"
            android:textColor="#F4F7FC"
            android:textSize="25sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/mask_editor_hint"
            android:textColor="#AAB8CC"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:orientation="vertical"
        android:background="@drawable/bg_studio_card"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SELECTION TOOLS"
            android:textColor="#91A8C5"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="3dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/mask_add_mode_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_mask_tool_selected"
                android:text="@string/mask_mode_add_selected"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:paddingHorizontal="4dp" />

            <Button
                android:id="@+id/mask_erase_mode_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_mask_tool_idle"
                android:text="@string/mask_mode_erase"
                android:textColor="#D9E3F0"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:paddingHorizontal="4dp" />

            <Button
                android:id="@+id/mask_magnetic_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_mask_tool_selected"
                android:text="@string/mask_magnetic_on"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:paddingHorizontal="3dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="7dp"
        android:text="PREVIEW"
        android:textColor="#91A8C5"
        android:textSize="10sp"
        android:letterSpacing="0.14"
        android:fontFamily="sans-serif-medium" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_mask_image_frame"
        android:padding="1dp"
        android:clipToPadding="true">

        <com.example.ios27clock.MaskDrawingView
            android:id="@+id/foreground_mask_drawing_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/mask_editor_canvas_description"
            android:background="#080D16" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_studio_card"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/mask_undo_button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_mask_tool_idle"
                android:text="@string/mask_undo"
                android:textColor="#E3EBF6"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/mask_clear_button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_mask_tool_idle"
                android:text="@string/mask_clear"
                android:textColor="#E3EBF6"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/mask_cancel_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_mask_tool_idle"
                android:text="@string/cancel"
                android:textColor="#DDE7F5"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/mask_save_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_mask_save"
                android:text="@string/mask_save"
                android:textColor="#10213A"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
