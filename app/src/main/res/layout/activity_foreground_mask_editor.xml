<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:orientation="vertical"
    android:paddingTop="36dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/mask_editor_title"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium" />

    <com.example.ios27clock.MaskDrawingView
        android:id="@+id/foreground_mask_drawing_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/mask_editor_canvas_description"
        android:background="#24313E" />

    <TextView
        android:id="@+id/foreground_brush_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="9dp"
        android:text="@string/mask_brush_size_initial"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />

    <SeekBar
        android:id="@+id/foreground_brush_seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:max="170"
        android:progress="54" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/mask_mode_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/mask_mode_paint"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/mask_lasso_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/mask_lasso"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/mask_undo_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/mask_undo"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/mask_clear_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/mask_clear"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp">

        <Button
            android:id="@+id/mask_cancel_button"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/mask_save_button"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:backgroundTint="#DAECFF"
            android:text="@string/mask_save"
            android:textColor="#101A2A"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
